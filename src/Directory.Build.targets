<Project>

  <!--
    Every shipped library packs on build, so a plain `dotnet build` of the solution
    always produces the full, version-consistent set of five packages.

    This lives in Directory.Build.targets rather than Directory.Build.props because
    .props is evaluated before the project body: IsPackable is not yet visible there,
    and unconditionally setting GeneratePackageOnBuild would warn on the sample apps
    that opt out via <IsPackable>false</IsPackable>.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
